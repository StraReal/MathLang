type Bool():
type Int():
type Str():
type Tuple():
type Dict():
type UndefinedType():
type AnyType():

Hypothesis:
    let Any be AnyType
    let Undefined be UndefinedType
    let boolean be Type = Bool
    let integer be Type = Int
    let string be Type = Str

@[extern str_conv]
operation stringConvert Int -> Str

@[extern str_conv]
operation stringConvert Type -> Str

operation stringConvert Bool -> Str
    if first
        gives "true"
    else
        gives "false"

operation Type into Type
    if second equals Str
        gives stringConvert first
    error "Can't convert type Type into " + (stringConvert second)

operation Type equals AnyType -> Bool
    gives true

operation Type != AnyType -> Bool
    gives false

operation Int <= Int -> Bool
    gives first < second or first equals second

operation Int >= Int -> Bool
    gives first > second or first equals second

operation isNatural Int -> Bool
    gives first>=0

operation isEven Int -> Bool
    gives first mod 2 equals 0
    witness k be Int: first equals 2 * k

operation fibonacci Int -> Int
    if first equals 0
        gives 0
    if first equals 1
        gives 1
    gives (fibonacci (first-1)) + (fibonacci (first-2))

operation Int gcd Int -> Int
    if second equals 0
        gives first
    gives second gcd (first mod second)


@[extern neg]
operation - Int -> Int

@[extern mod]
operation Int mod Int -> Int

@[extern add]
operation Int + Int -> Int

@[extern mul]
operation Int * Int -> Int

@[extern exp]
operation Int ^ Int -> Int


@[extern gt]
operation Int > Int -> Bool

@[extern lt]
operation Int < Int -> Bool

@[extern int_div]
operation Int div Int -> Int


@[extern sub]
operation Int - Int -> Int

@[extern and]
operation Bool and Bool -> Bool

@[extern or]
operation Bool or Bool -> Bool

operation not Bool -> Bool
    gives first equals false


@[extern fact]
operation Int ! -> Int


operation Bool nand Bool -> Bool
    gives not (first and second)

operation Bool nor Bool -> Bool
    gives not (first or second)

operation Bool xor Bool -> Bool
    gives not (first equals second)

operation Bool != Bool -> Bool # yes, it's the same
    gives not (first equals second)

@[extern len]
operation length Tuple -> Int

@[extern len]
operation length Dict -> Int


@[extern add]
operation Str + Str -> Str

@[extern mul]
operation Str * Int -> Str

operation Str != Str -> Str
    gives not (first equals second)


@[extern len]
operation length Str -> Int

@[extern in]
operation Int in Tuple -> Bool

@[extern in]
operation Str in Tuple -> Bool

@[extern in]
operation Tuple in Tuple -> Bool

@[extern in]
operation Dict in Tuple -> Bool

@[extern in]
operation Bool in Tuple -> Bool


@[extern in]
operation Int in Str -> Bool

@[extern in]
operation Str in Str -> Bool

@[extern int_conv]
operation integerConvert Str -> Int

operation Int into Type
    if second equals Bool
        gives first != 0
    if second equals Str
        gives stringConvert first
    if second equals Int
        gives first
    error "Can't convert type Int into " + (stringConvert second)


operation Str into Type
    if second equals Bool
        gives first != ""
    if second equals Str
        gives first
    if second equals Int
        gives integerConvert first
    error "Can't convert type Str into " + (stringConvert second)

operation validFraction Dict -> Bool
    if (length first) != 2
        gives false
    if (typeOf first) != Int or (typeOf second) != Int
        gives false
    gives true

type Fraction(n, d = 1): 
    recordType
    let self's numerator   be Int = n
    let self's denominator be Int = d

operation Fraction into Type;Str
    if second equals Str
        gives (first's numerator into Str) + "/" + (first's denominator into Str)
    if second equals Int
        if (first's numerator) gcd (first's denominator) equals (first's denominator)
            gives first's numerator div first's denominator
        else
            error "Fraction " + (first into Str) + " can't be converted into integer"
    error "Can't convert type Tuple into " + (stringConvert second)

operation simplifyFraction Tuple -> Fraction
    let numerator be integer = first[0]
    let denominator be integer = first[1]
    let g be integer = numerator gcd denominator
    gives ((numerator div g, denominator div g) into Fraction)

operation simplifyFraction Fraction -> Fraction
    let numerator be integer = first's numerator
    let denominator be integer = first's denominator
    let g be integer = numerator gcd denominator
    gives ((numerator div g, denominator div g) into Fraction)

operation Fraction * Fraction -> Fraction
    let newNumerator be integer = first's numerator * second's numerator
    let newDenominator be integer = first's denominator * second's denominator
    let newFraction be Fraction = simplifyFraction (newNumerator, newDenominator)
    gives newFraction
    
operation Fraction / Fraction -> Fraction
    let newNumerator be integer = first's numerator * second's denominator
    let newDenominator be integer = first's denominator * second's numerator
    let newFraction be Fraction = simplifyFraction (newNumerator, newDenominator)
    gives newFraction


operation Fraction + Fraction -> Fraction
    let newNumerator be integer = (first's numerator * second's denominator) + (second's numerator * first's denominator)
    let newDenominator be integer = first's denominator * second's denominator
    let newFraction be Fraction = simplifyFraction (newNumerator, newDenominator)
    gives newFraction

operation Fraction equals Int -> Bool
    if first's numerator gcd first's denominator equals first's denominator
        gives (first into Int) equals second
    else
        gives false

operation Int / Int -> Fraction
    gives simplifyFraction (first, second)

operation Fraction * Int -> Fraction
    gives simplifyFraction (first's numerator * second, first's denominator)

operation Fraction / Int -> Fraction
    gives simplifyFraction (first's numerator, first's denominator * second)

operation Int % -> Fraction
    gives first / 100

operation Fraction % -> Fraction
    gives first / 100

operation Int % of Int -> Fraction
    gives (first / 100) * second

operation Fraction % of Int -> Fraction
    gives (first / 100) * second

operation Int % of Fraction -> Fraction
    gives (first / 100) * second

operation Fraction % of Fraction -> Fraction
    gives (first / 100) * second

operation Fraction ^ Int -> Fraction
    gives simplifyFraction (first's numerator ^ second, first's denominator ^ second)

@[extern print]
operation print Int -> Undefined

@[extern print]
operation print Str -> Undefined

@[extern print]
operation print Tuple -> Undefined

@[extern print]
operation print Type -> Undefined

operation print Fraction -> Undefined
    print (first into Str)

operation print Bool -> Undefined
    print Str(first)

operation Tuple into Type;Str
    gives stringConvert first
    
operation Bool into Type;Str
    gives stringConvert first

axiom SideSwitching:
    Given:
        let a be Int
        let b be Int
    Then:
        a + b = b + a